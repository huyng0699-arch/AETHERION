# Example for local development; the application does NOT auto-load .env files.
# Set these in PowerShell or the process environment before launching.
AETHERION_CONFIG_VERSION=1
AETHERION_PROFILE=development
AETHERION_HOST=127.0.0.1
AETHERION_PORT=8765
AETHERION_API_URL=http://127.0.0.1:8765
# Optional: AETHERION_DB_PATH=C:\AETHERION\dev.sqlite3
# Release profile remains loopback-only: NOT public- or clinical-use certified.
# Release requires an absolute AETHERION_DB_PATH and forbids bootstrap credentials in env.
# Provision account offline via aetherion-bootstrap before release startup.
