{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetherion.local/contracts/v1/timestamp_units.schema.json",
  "title": "AETHERION Timestamp and Measurement Units Contract (Q-0018)",
  "description": "Requires timezone-offset-aware observed_at, server-recorded received_at, and declared measurement units.",
  "type": "object",
  "additionalProperties": false,
  "required": ["observed_at", "received_at", "unit"],
  "properties": {
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "received_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    }
  },
  "x-canonical-units": {
    "heart_rate": ["beats/min", "bpm"],
    "spo2": ["%"],
    "body_temperature": ["degC", "C"],
    "body_mass": ["kg"],
    "cabin_co2": ["ppm", "mmHg"],
    "sleep_duration": ["h", "min"]
  }
}
