{
  "expo": {
    "name": "AETHERION Mobile",
    "slug": "aetherion-mobile",
    "scheme": "aetherion",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/truy-tinh-cosmic-orbit.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/truy-tinh-cosmic-orbit.png",
      "resizeMode": "contain",
      "backgroundColor": "#020718"
    },
    "newArchEnabled": true,
    "android": {
      "package": "io.truytinh.aetherion.mobile",
      "softwareKeyboardLayoutMode": "pan",
      "edgeToEdgeEnabled": true,
      "usesCleartextTraffic": false
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "io.truytinh.aetherion.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": ["expo-secure-store"],
    "experiments": {
      "typedRoutes": false
    }
  }
}

